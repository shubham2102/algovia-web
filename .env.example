# OpenAI — primary LLM + embeddings (optional for live responses)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Alternative LLM provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Site URLs (used in CTAs, metadata, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://algovia.ai
NEXT_PUBLIC_WORKSHOP_URL=https://calendly.com/algovia/workshop
NEXT_PUBLIC_UPLOAD_URL=https://forms.gle/placeholder

# Database — stores chat conversations, lead/contact submissions, and
# Schedule-a-Meeting bookings. On Vercel: Project → Storage → Create Database
# → Postgres (Neon) → Connect to Project. This auto-injects POSTGRES_URL.
# For local dev, run `vercel env pull .env.local` after linking the project,
# or point this at any Postgres instance (Neon/Supabase/local all work).
# Tables are created automatically on first use — no manual migration needed.
# Leaving this unset falls back to a local data/leads.jsonl file (dev only —
# does NOT persist on Vercel's serverless filesystem).
POSTGRES_URL=

# File uploads (CVs from Careers/Network forms). On Vercel: Project → Storage
# → Create → Blob → Connect to Project. Newer connections use ambient OIDC
# credentials instead of a static token — in that case Vercel injects
# BLOB_STORE_ID (+ VERCEL_OIDC_TOKEN) and @vercel/blob picks both up
# automatically; BLOB_READ_WRITE_TOKEN below is only needed for older/manual
# token-based connections. Leaving both unset falls back to writing to local
# disk in dev (not viable on Vercel — connect Blob before deploying if CV
# uploads matter).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional: pgvector / Supabase for production RAG (Phase 2)
# DATABASE_URL=
